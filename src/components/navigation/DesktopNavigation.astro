---
import { primaryNav } from "@data/navigation";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

function isActive(href: string, path: string): boolean {
  if (href.startsWith("/#")) return false;
  const clean = href.replace(/\/$/, "") || "/";
  const current = path.replace(/\/$/, "") || "/";
  return clean === current;
}
---

<nav aria-label="Primary" class="hidden lg:block">
  <ul class="flex items-center gap-0.5">
    {
      primaryNav.map((item) => {
        const active = isActive(item.href, currentPath);
        return (
          <li class="relative" data-dropdown={item.children ? "" : undefined}>
            {item.children ? (
              <>
                <button
                  type="button"
                  class="nav-link dropdown-trigger group flex items-center gap-1.5 px-4 py-2.5 text-sm font-medium text-[var(--color-text-primary)]"
                  aria-expanded="false"
                >
                  {item.label}
                  <svg
                    aria-hidden="true"
                    class="h-3 w-3 transition-transform duration-[var(--duration-control)] group-aria-expanded:rotate-180"
                    viewBox="0 0 12 12"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                  >
                    <path d="M3 4.5 6 7.5 9 4.5" />
                  </svg>
                </button>
                <div class="dropdown-panel invisible absolute left-0 top-full z-40 w-80 pt-3 opacity-0">
                  <div class="glass-panel-strong border-t-2 border-t-[var(--color-brand)] p-2">
                    <ul class="flex flex-col">
                      {item.children.map((child) => (
                        <li>
                          <a
                            href={child.href}
                            class="dropdown-item group/item relative flex flex-col gap-0.5 px-4 py-3 transition-colors duration-[var(--duration-control)] hover:bg-[var(--color-brand)]/8"
                          >
                            <span class="flex items-center gap-2 text-sm font-semibold text-[var(--color-text-primary)]">
                              {child.label}
                              <svg
                                aria-hidden="true"
                                class="h-3 w-3 -translate-x-1 text-[var(--color-brand)] opacity-0 transition-all duration-[var(--duration-control)] group-hover/item:translate-x-0 group-hover/item:opacity-100"
                                viewBox="0 0 12 12"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.8"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              >
                                <path d="M2 6h8M6.5 2.5 10 6l-3.5 3.5" />
                              </svg>
                            </span>
                            {child.description && (
                              <span class="text-xs text-[var(--color-text-secondary)]">
                                {child.description}
                              </span>
                            )}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </>
            ) : (
              <a
                href={item.href}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "nav-link block px-4 py-2.5 text-sm font-medium",
                  active
                    ? "is-active text-[var(--color-brand)]"
                    : "text-[var(--color-text-primary)]",
                ]}
              >
                {item.label}
              </a>
            )}
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  .nav-link {
    position: relative;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 0.4rem;
    height: 2px;
    background: var(--color-brand);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--duration-control) var(--ease-orbit);
  }

  .nav-link:hover::after,
  .nav-link[aria-expanded="true"]::after {
    transform: scaleX(1);
  }

  .nav-link.is-active::after {
    transform: scaleX(1);
  }

  .dropdown-panel {
    transform: translateY(-4px);
    transition:
      opacity var(--duration-control) var(--ease-orbit),
      transform var(--duration-control) var(--ease-orbit),
      visibility var(--duration-control) var(--ease-orbit);
  }

  [data-dropdown]:hover .dropdown-panel,
  [data-dropdown]:focus-within .dropdown-panel,
  [data-dropdown] .dropdown-trigger[aria-expanded="true"] ~ .dropdown-panel {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .dropdown-panel,
    .nav-link::after {
      transition: opacity 1ms linear;
    }
  }
</style>

<script>
  const groups = document.querySelectorAll<HTMLElement>("[data-dropdown]");

  groups.forEach((group) => {
    const trigger = group.querySelector<HTMLButtonElement>(".dropdown-trigger");
    if (!trigger) return;

    const close = () => trigger.setAttribute("aria-expanded", "false");
    const open = () => trigger.setAttribute("aria-expanded", "true");

    trigger.addEventListener("click", () => {
      const isOpen = trigger.getAttribute("aria-expanded") === "true";
      groups.forEach((g) =>
        g.querySelector(".dropdown-trigger")?.setAttribute("aria-expanded", "false"),
      );
      if (!isOpen) open();
    });

    group.addEventListener("focusout", (event) => {
      const next = (event as FocusEvent).relatedTarget as Node | null;
      if (!next || !group.contains(next)) close();
    });

    group.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        close();
        trigger.focus();
      }
    });
  });

  document.addEventListener("click", (event) => {
    groups.forEach((group) => {
      if (!group.contains(event.target as Node)) {
        group.querySelector(".dropdown-trigger")?.setAttribute("aria-expanded", "false");
      }
    });
  });
</script>
