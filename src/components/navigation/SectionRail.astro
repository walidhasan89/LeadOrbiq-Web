---
import { homepageSections } from "@data/navigation";
---

<!-- Desktop / laptop rail -->
<nav
  aria-label="Page sections"
  class="section-rail pointer-events-none fixed right-5 top-1/2 z-40 hidden -translate-y-1/2 xl:block"
>
  <ol
    class="glass-panel pointer-events-auto flex flex-col items-center gap-1 rounded-[var(--radius-pill)] p-2.5"
  >
    {
      homepageSections.map((section, index) => (
        <li class="relative">
          <a
            href={`#${section.id}`}
            data-rail-link={section.id}
            class="rail-dot group relative flex h-7 w-7 items-center justify-center rounded-full transition-colors duration-[var(--duration-control)]"
            aria-current={index === 0 ? "true" : undefined}
          >
            <span
              aria-hidden="true"
              class="rail-dot-mark h-1.5 w-1.5 rounded-full bg-[var(--color-text-secondary)] transition-all duration-[var(--duration-control)]"
            />
            <span class="sr-only">{section.label}</span>
            <span
              role="tooltip"
              class="rail-label pointer-events-none absolute right-full mr-3 whitespace-nowrap rounded-[var(--radius-sm)] bg-[var(--color-bg-elevated)] px-3 py-1.5 text-xs font-medium text-[var(--color-text-primary)] opacity-0 shadow-[var(--shadow-elevation)] transition-opacity duration-[var(--duration-control)] group-hover:opacity-100 group-focus-visible:opacity-100"
            >
              {section.label}
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<!-- Mobile / tablet progress pill -->
<div
  class="progress-pill glass-panel-strong pointer-events-none fixed inset-x-0 bottom-4 z-40 mx-auto flex w-[min(92%,22rem)] items-center gap-3 rounded-[var(--radius-pill)] px-4 py-2.5 xl:hidden"
  role="progressbar"
  aria-label="Scroll progress"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
  id="scroll-progress-pill"
>
  <span
    id="progress-pill-label"
    class="min-w-0 flex-1 truncate text-xs font-semibold text-[var(--color-text-primary)]"
    >Overview</span
  >
  <span class="relative h-1.5 w-16 shrink-0 overflow-hidden rounded-full bg-[var(--color-border)]">
    <span
      id="progress-pill-fill"
      class="absolute inset-y-0 left-0 w-0 rounded-full bg-[image:var(--gradient-brand)]"></span>
  </span>
</div>

<style>
  .rail-dot[aria-current="true"] .rail-dot-mark {
    background-color: var(--color-brand);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-brand) 22%, transparent);
    transform: scale(1.3);
  }

  @media (prefers-reduced-motion: reduce) {
    .rail-label,
    .rail-dot-mark,
    #progress-pill-fill {
      transition: none;
    }
  }
</style>

<script>
  const sections = Array.from(document.querySelectorAll<HTMLElement>("main [data-rail-section]"));
  const railLinks = document.querySelectorAll<HTMLAnchorElement>("[data-rail-link]");
  const pill = document.getElementById("scroll-progress-pill");
  const pillFill = document.getElementById("progress-pill-fill");
  const pillLabel = document.getElementById("progress-pill-label");

  function setActive(id: string) {
    railLinks.forEach((link) => {
      const isActive = link.dataset.railLink === id;
      link.setAttribute("aria-current", isActive ? "true" : "false");
      if (isActive && pillLabel) {
        pillLabel.textContent = link.querySelector(".sr-only")?.textContent ?? id;
      }
    });
  }

  if (sections.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute("id");
            if (id) setActive(id);
          }
        });
      },
      { rootMargin: "-45% 0px -45% 0px", threshold: 0 },
    );
    sections.forEach((section) => observer.observe(section));
  }

  if (pill && pillFill) {
    let ticking = false;
    function updateProgress() {
      const doc = document.documentElement;
      const scrollTop = doc.scrollTop || document.body.scrollTop;
      const height = doc.scrollHeight - doc.clientHeight;
      const pct = height > 0 ? Math.min(100, Math.max(0, (scrollTop / height) * 100)) : 0;
      pillFill!.style.width = `${pct}%`;
      pill!.setAttribute("aria-valuenow", String(Math.round(pct)));
      ticking = false;
    }
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(updateProgress);
          ticking = true;
        }
      },
      { passive: true },
    );
    updateProgress();
  }

  railLinks.forEach((link) => {
    link.addEventListener("click", (event) => {
      const id = link.dataset.railLink;
      const target = id ? document.getElementById(id) : null;
      if (!target) return;
      event.preventDefault();
      const headerOffset = 96;
      const top = target.getBoundingClientRect().top + window.scrollY - headerOffset;
      window.scrollTo({ top, behavior: "smooth" });
      history.replaceState(null, "", `#${id}`);
      target.setAttribute("tabindex", "-1");
      target.focus({ preventScroll: true });
    });
  });
</script>
