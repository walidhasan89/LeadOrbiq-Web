---
import { primaryNav } from "@data/navigation";
import Button from "@components/common/Button.astro";
import ThemeToggle from "@components/navigation/ThemeToggle.astro";
import { siteConfig } from "@data/site";

interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;

// Dropdown children (Product, Resources) repeat some of the same
// destinations as their own top-level shortcuts (Use Cases, Pricing) — fine
// on desktop where they're two separate visual contexts, but flattened into
// one mobile list that would show duplicate rows. De-dupe by href, keeping
// first occurrence, so every destination appears exactly once.
const seen = new Set<string>();
const links = primaryNav
  .flatMap((item) => (item.children && item.children.length > 0 ? item.children : [item]))
  .filter((link) => {
    if (seen.has(link.href)) return false;
    seen.add(link.href);
    return true;
  });
---

<button
  type="button"
  id="mobile-nav-trigger"
  class="hamburger-btn relative flex h-11 w-11 shrink-0 items-center justify-center border border-[var(--color-border)] bg-[var(--color-surface)] lg:hidden"
  aria-label="Open menu"
  aria-expanded="false"
  aria-controls="mobile-nav-panel"
>
  <span class="relative block h-3.5 w-5" aria-hidden="true">
    <span class="hamburger-bar hamburger-bar-top absolute left-0 top-0 h-0.5 w-full bg-current"
    ></span>
    <span
      class="hamburger-bar hamburger-bar-mid absolute left-0 top-1/2 h-0.5 w-full -translate-y-1/2 bg-current"
    ></span>
    <span class="hamburger-bar hamburger-bar-bottom absolute bottom-0 left-0 h-0.5 w-full bg-current"
    ></span>
  </span>
</button>

<div
  id="mobile-nav-panel"
  class="mobile-nav-panel invisible fixed inset-0 z-[100] flex flex-col bg-[var(--ink-950)] text-[var(--color-text-inverted)] opacity-0 lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Site menu"
  hidden
>
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <svg class="h-full w-full opacity-40" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="mobile-nav-grid" width="48" height="48" patternUnits="userSpaceOnUse">
          <path d="M48 0H0V48" fill="none" stroke="rgba(159,178,214,0.1)" stroke-width="1"></path>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#mobile-nav-grid)"></rect>
    </svg>
    <div
      class="absolute -top-24 right-[-20%] h-80 w-80 rounded-full opacity-50 blur-3xl"
      style="background: radial-gradient(circle, color-mix(in srgb, var(--mint) 55%, transparent), transparent 70%);"
    >
    </div>
  </div>

  <div class="relative flex items-center justify-between px-5 pt-5 sm:px-8">
    <span class="text-xs font-semibold uppercase tracking-[0.2em] text-white/50">Menu</span>
    <button
      type="button"
      id="mobile-nav-close"
      class="flex h-10 w-10 items-center justify-center border border-white/15 text-white"
      aria-label="Close menu"
    >
      <svg
        aria-hidden="true"
        class="h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
      >
        <path d="M6 6l12 12M18 6 6 18"></path>
      </svg>
    </button>
  </div>

  <nav aria-label="Mobile" class="relative flex flex-1 flex-col justify-center px-5 sm:px-8">
    <ul class="flex flex-col">
      {
        links.map((link, index) => (
          <li
            class="mobile-nav-item overflow-hidden border-b border-white/10 first:border-t"
            style={`--stagger: ${index}`}
          >
            <a
              href={link.href}
              data-mobile-link
              aria-current={
                currentPath.replace(/\/$/, "") === link.href.replace(/\/$/, "")
                  ? "page"
                  : undefined
              }
              class="group flex items-center gap-4 py-4"
            >
              <span class="text-xs font-semibold text-[var(--mint)]">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="flex-1 text-3xl font-bold tracking-tight text-white transition-transform duration-[var(--duration-control)] group-hover:translate-x-2 sm:text-4xl">
                {link.label}
              </span>
              <svg
                aria-hidden="true"
                class="h-5 w-5 shrink-0 -translate-x-2 text-[var(--mint)] opacity-0 transition-all duration-[var(--duration-control)] group-hover:translate-x-0 group-hover:opacity-100"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M3 8h10M8.5 3.5 13 8l-4.5 4.5" />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="relative flex flex-col gap-4 border-t border-white/10 px-5 py-6 sm:px-8">
    <div class="flex items-center justify-between">
      <span class="text-sm text-white/60">Theme</span>
      <ThemeToggle />
    </div>
    <Button href={siteConfig.chromeStoreUrl} external variant="primary" size="lg" class="w-full">
      Add to Chrome
    </Button>
  </div>
</div>

<style>
  .hamburger-bar {
    transition:
      transform var(--duration-control) var(--ease-orbit),
      opacity var(--duration-control) var(--ease-orbit);
  }

  .hamburger-btn[aria-expanded="true"] .hamburger-bar-top {
    transform: translateY(6px) rotate(45deg);
  }

  .hamburger-btn[aria-expanded="true"] .hamburger-bar-mid {
    opacity: 0;
    transform: translateY(-50%) scaleX(0);
  }

  .hamburger-btn[aria-expanded="true"] .hamburger-bar-bottom {
    transform: translateY(-6px) rotate(-45deg);
  }

  .mobile-nav-panel {
    transition:
      opacity var(--duration-card) var(--ease-orbit),
      visibility var(--duration-card) var(--ease-orbit);
  }

  .mobile-nav-panel.is-open {
    visibility: visible;
    opacity: 1;
  }

  .mobile-nav-item {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity var(--duration-card) var(--ease-orbit),
      transform var(--duration-card) var(--ease-orbit);
    transition-delay: calc(var(--stagger) * 55ms);
  }

  .mobile-nav-panel.is-open .mobile-nav-item {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .hamburger-bar,
    .mobile-nav-item {
      transition-delay: 0ms;
    }
  }
</style>

<script>
  const trigger = document.getElementById("mobile-nav-trigger");
  const panel = document.getElementById("mobile-nav-panel");
  const closeBtn = document.getElementById("mobile-nav-close");

  if (trigger && panel && closeBtn) {
    const focusableSelector =
      'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])';

    function getFocusable(): HTMLElement[] {
      return Array.from(panel!.querySelectorAll<HTMLElement>(focusableSelector));
    }

    function openMenu() {
      panel!.hidden = false;
      requestAnimationFrame(() => panel!.classList.add("is-open"));
      trigger!.setAttribute("aria-expanded", "true");
      document.body.classList.add("nav-open");
      // Deferred: focusing a descendant right after clearing `hidden` can be
      // undone by the browser's own default focus handling for the click
      // that opened the menu, if done within the same frame. A short delay
      // lets that settle first.
      setTimeout(() => {
        getFocusable()[0]?.focus();
      }, 60);
    }

    function closeMenu() {
      panel!.classList.remove("is-open");
      trigger!.setAttribute("aria-expanded", "false");
      document.body.classList.remove("nav-open");
      trigger!.focus();
      setTimeout(() => {
        if (!panel!.classList.contains("is-open")) panel!.hidden = true;
      }, 320);
    }

    trigger.addEventListener("click", openMenu);
    closeBtn.addEventListener("click", closeMenu);

    panel.querySelectorAll<HTMLAnchorElement>("[data-mobile-link]").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && trigger!.getAttribute("aria-expanded") === "true") {
        closeMenu();
      }
    });

    panel.addEventListener("keydown", (event) => {
      if (event.key !== "Tab") return;

      const focusable = getFocusable();
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  }
</script>
