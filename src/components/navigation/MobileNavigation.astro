---
import { primaryNav } from "@data/navigation";
import Button from "@components/common/Button.astro";
import ThemeToggle from "@components/navigation/ThemeToggle.astro";
import { siteConfig } from "@data/site";

interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;
---

<button
  type="button"
  id="mobile-nav-trigger"
  class="flex h-11 w-11 items-center justify-center rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] lg:hidden"
  aria-label="Open menu"
  aria-expanded="false"
  aria-controls="mobile-nav-panel"
>
  <svg
    aria-hidden="true"
    class="h-5 w-5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
  >
    <path d="M4 7h16M4 12h16M4 17h16"></path>
  </svg>
</button>

<div
  id="mobile-nav-panel"
  class="mobile-nav-panel invisible fixed inset-0 z-[100] flex justify-end opacity-0 lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Site menu"
  hidden
>
  <div
    class="mobile-nav-backdrop absolute inset-0 bg-[var(--ink-950)]/60 backdrop-blur-sm"
    data-nav-backdrop
  >
  </div>

  <div
    class="glass-panel-strong relative flex h-full w-full max-w-sm flex-col gap-8 overflow-y-auto rounded-l-[var(--radius-panel)] p-6"
  >
    <div class="flex items-center justify-between">
      <span class="text-sm font-semibold uppercase tracking-wide text-[var(--color-text-secondary)]"
        >Menu</span
      >
      <button
        type="button"
        id="mobile-nav-close"
        class="flex h-10 w-10 items-center justify-center rounded-full border border-[var(--color-border)]"
        aria-label="Close menu"
      >
        <svg
          aria-hidden="true"
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
        >
          <path d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>

    <nav aria-label="Mobile" class="flex flex-col gap-1">
      {
        primaryNav
          .flatMap((item) => (item.children && item.children.length > 0 ? item.children : [item]))
          .map((link) => (
            <a
              href={link.href}
              data-mobile-link
              aria-current={
                currentPath.replace(/\/$/, "") === link.href.replace(/\/$/, "") ? "page" : undefined
              }
              class="rounded-[var(--radius-md)] px-3 py-3.5 text-lg font-medium text-[var(--color-text-primary)] transition-colors hover:bg-[var(--color-surface)]"
            >
              {link.label}
            </a>
          ))
      }
    </nav>

    <div class="mt-auto flex flex-col gap-4 border-t border-[var(--color-border)] pt-6">
      <div class="flex items-center justify-between">
        <span class="text-sm text-[var(--color-text-secondary)]">Theme</span>
        <ThemeToggle />
      </div>
      <Button href={siteConfig.chromeStoreUrl} external variant="primary" size="lg" class="w-full">
        Add to Chrome
      </Button>
    </div>
  </div>
</div>

<style>
  .mobile-nav-panel {
    transition:
      opacity var(--duration-control) var(--ease-orbit),
      visibility var(--duration-control) var(--ease-orbit);
  }
  .mobile-nav-panel.is-open {
    visibility: visible;
    opacity: 1;
  }
  .mobile-nav-panel .glass-panel-strong {
    transform: translateX(16px);
    transition: transform var(--duration-card) var(--ease-orbit);
  }
  .mobile-nav-panel.is-open .glass-panel-strong {
    transform: translateX(0);
  }
</style>

<script>
  const trigger = document.getElementById("mobile-nav-trigger");
  const panel = document.getElementById("mobile-nav-panel");
  const closeBtn = document.getElementById("mobile-nav-close");
  const backdrop = panel?.querySelector<HTMLElement>("[data-nav-backdrop]");

  if (trigger && panel && closeBtn) {
    const focusableSelector =
      'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])';

    function getFocusable(): HTMLElement[] {
      return Array.from(panel!.querySelectorAll<HTMLElement>(focusableSelector));
    }

    function openMenu() {
      panel!.hidden = false;
      requestAnimationFrame(() => panel!.classList.add("is-open"));
      trigger!.setAttribute("aria-expanded", "true");
      document.body.classList.add("nav-open");
      // Deferred: focusing a descendant right after clearing `hidden` can be
      // undone by the browser's own default focus handling for the click
      // that opened the menu, if done within the same frame. A short delay
      // lets that settle first.
      setTimeout(() => {
        getFocusable()[0]?.focus();
      }, 60);
    }

    function closeMenu() {
      panel!.classList.remove("is-open");
      trigger!.setAttribute("aria-expanded", "false");
      document.body.classList.remove("nav-open");
      trigger!.focus();
      setTimeout(() => {
        if (!panel!.classList.contains("is-open")) panel!.hidden = true;
      }, 260);
    }

    trigger.addEventListener("click", openMenu);
    closeBtn.addEventListener("click", closeMenu);
    backdrop?.addEventListener("click", closeMenu);

    panel.querySelectorAll<HTMLAnchorElement>("[data-mobile-link]").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && trigger!.getAttribute("aria-expanded") === "true") {
        closeMenu();
      }
    });

    panel.addEventListener("keydown", (event) => {
      if (event.key !== "Tab") return;

      const focusable = getFocusable();
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  }
</script>
