---
import { breadcrumbSchema, type BreadcrumbEntry } from "@utils/seo";
import StructuredData from "@components/seo/StructuredData.astro";

interface Props {
  items: BreadcrumbEntry[];
  size?: "narrow" | "content" | "main" | "wide";
}

const { items, size = "main" } = Astro.props;
const withHome: BreadcrumbEntry[] = [{ label: "Home", href: "/" }, ...items];

const sizeClass: Record<NonNullable<Props["size"]>, string> = {
  narrow: "container-narrow",
  content: "container-content",
  main: "container-main",
  wide: "container-wide",
};
---

<nav aria-label="Breadcrumb" class:list={[sizeClass[size], "pt-8"]}>
  <ol
    class="glass-panel inline-flex flex-wrap items-center gap-1.5 !rounded-[var(--radius-pill)] px-4 py-2 text-xs text-[var(--color-text-secondary)]"
  >
    {
      withHome.map((item, index) => {
        const isLast = index === withHome.length - 1;
        const isFirst = index === 0;
        return (
          <li class="flex items-center gap-1.5">
            {index > 0 && (
              <svg
                aria-hidden="true"
                class="h-3 w-3 shrink-0 text-[var(--color-border-strong)]"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m6 3.5 5 4.5-5 4.5" />
              </svg>
            )}
            {isLast ? (
              <span aria-current="page" class="font-medium text-[var(--color-text-primary)]">
                {item.label}
              </span>
            ) : (
              <a
                href={item.href}
                class="flex items-center gap-1.5 rounded-sm transition-colors hover:text-[var(--color-brand)]"
              >
                {isFirst && (
                  <svg
                    aria-hidden="true"
                    class="h-3.5 w-3.5 shrink-0"
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M2 7.5 8 2l6 5.5M3.5 6.5V14h9V6.5" />
                  </svg>
                )}
                {item.label}
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
<StructuredData schemas={[breadcrumbSchema(withHome)]} />
