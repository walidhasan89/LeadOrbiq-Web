---
import Container from "@components/common/Container.astro";
import SectionHeading from "@components/common/SectionHeading.astro";
import UseCaseCard from "@components/common/UseCaseCard.astro";
import { useCases } from "@data/use-cases";
---

<section
  id="use-cases"
  data-rail-section
  class="section-spacing relative border-t border-[var(--color-border)]"
>
  <Container size="wide">
    <SectionHeading
      eyebrow="Made for people who build targeted lists"
      title="A practical research workflow for different growth teams."
    />
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {useCases.map((useCase) => <UseCaseCard useCase={useCase} />)}
    </div>
  </Container>
</section>
