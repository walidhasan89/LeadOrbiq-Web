---

<div
  id="trust-strip"
  class="relative z-30 flex items-center justify-center gap-2.5 border-b border-[var(--color-border)] bg-[var(--color-bg-soft)] px-4 py-2.5 text-center text-xs font-medium text-[var(--color-text-secondary)] sm:text-sm"
>
  <span
    class="orbit-dot h-1.5 w-1.5 shrink-0 rounded-none bg-[var(--color-accent)]"
    aria-hidden="true"></span>
  <p class="pretty">
    Chrome extension for faster, more organized local-business prospecting.
    <span class="hidden sm:inline">Use responsibly.</span>
  </p>
</div>

<style>
  .orbit-dot {
    animation: pulse-glow 2.6s var(--ease-orbit) infinite;
  }
  @keyframes pulse-glow {
    0%,
    100% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-accent) 45%, transparent);
    }
    50% {
      box-shadow: 0 0 0 5px color-mix(in srgb, var(--color-accent) 0%, transparent);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .orbit-dot {
      animation: none;
    }
  }
</style>
