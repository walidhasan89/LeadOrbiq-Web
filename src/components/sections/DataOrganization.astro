---
import Container from "@components/common/Container.astro";
import SectionHeading from "@components/common/SectionHeading.astro";
import LeadTableVisual from "@components/product-visuals/LeadTableVisual.astro";
import { dataFields } from "@data/workflow";
---

<section
  id="data"
  data-rail-section
  class="section-spacing relative border-t border-[var(--color-border)]"
>
  <Container size="wide">
    <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:items-center">
      <div class="flex flex-col gap-6">
        <SectionHeading
          eyebrow="Clearer prospect information"
          title="Keep important business details easier to review."
          body="LeadOrbiq organizes business information as you research prospects on Google Maps, and uses AI to scan each business's website for its email, phone number, and social media links."
        />
        <ul class="flex flex-wrap gap-2.5">
          {
            dataFields.map((field) => (
              <li
                class:list={[
                  "flex items-center gap-1.5 rounded-none border px-3.5 py-1.5 text-sm",
                  field.verified
                    ? "border-[var(--color-brand)]/35 bg-[var(--color-brand)]/8 text-[var(--color-text-primary)]"
                    : "border-[var(--color-border)] text-[var(--color-text-secondary)]",
                ]}
              >
                {field.label}
                {!field.verified && (
                  <span class="text-[0.65rem] font-semibold uppercase tracking-wide text-[var(--color-warning)]">
                    Verify
                  </span>
                )}
              </li>
            ))
          }
        </ul>
        <p class="text-xs text-[var(--color-text-secondary)]">
          Fields marked "Verify" are not yet confirmed and are shown only as planned structure, not
          current capability.
        </p>
      </div>

      <LeadTableVisual />
    </div>
  </Container>
</section>
