---
import Container from "@components/common/Container.astro";
import SectionHeading from "@components/common/SectionHeading.astro";
import FeatureCard from "@components/common/FeatureCard.astro";
import { bentoFeatures } from "@data/features";

const icons: Array<
  "map" | "grid" | "clock" | "review" | "layers" | "export" | "duplicate" | "search"
> = ["search", "map", "review", "export", "layers", "grid", "clock", "duplicate"];
---

<section
  id="features"
  data-rail-section
  class="section-spacing relative border-t border-[var(--color-border)]"
>
  <Container size="wide">
    <SectionHeading
      eyebrow="Built for practical prospecting"
      title="The structure you need without a complicated workflow."
    />
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        bentoFeatures.map((feature, index) => {
          // Seven cards, first spans 2 columns: row one is 2+1+1 (4 cols),
          // row two is 1+1+1+1 (4 cols) — two full rows, no orphan card.
          const isFirst = index === 0;
          return (
            <FeatureCard
              title={feature.title}
              description={feature.description}
              verified={feature.verified}
              icon={icons[index % icons.length]}
              class={isFirst ? "sm:col-span-2" : undefined}
            />
          );
        })
      }
    </div>
  </Container>
</section>
