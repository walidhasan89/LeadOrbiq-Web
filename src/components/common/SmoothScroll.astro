---
// Momentum-based smooth scrolling (Lenis). CSS `scroll-behavior: smooth`
// only smooths anchor-link jumps and programmatic scrollTo calls — everyday
// mouse-wheel/trackpad scrolling is native/instant in every browser. Lenis
// intercepts wheel and touch input to give scrolling itself an eased,
// momentum feel. Instantiated here, before any other script that might
// scroll the page, and exposed on window.__lenis so SectionRail and
// ScrollToTop can route their programmatic scrolls through the same
// instance instead of fighting it with a raw window.scrollTo.
---

<script>
  import Lenis from "lenis";

  declare global {
    interface Window {
      __lenis?: Lenis;
    }
  }

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReducedMotion) {
    const lenis = new Lenis({
      duration: 1.05,
      smoothWheel: true,
      wheelMultiplier: 1,
      touchMultiplier: 1.2,
    });

    function raf(time: number) {
      lenis.raf(time);
      requestAnimationFrame(raf);
    }
    requestAnimationFrame(raf);

    window.__lenis = lenis;
  }
</script>
