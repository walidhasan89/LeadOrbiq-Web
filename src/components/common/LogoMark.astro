---
interface Props {
  variant?: "icon" | "full";
  size?: number;
  class?: string;
}

const { variant = "icon", size = 32, class: className = "" } = Astro.props;
---

<span class:list={["inline-flex items-center gap-2.5", className]}>
  <svg
    width={size}
    height={size}
    viewBox="0 0 32 32"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="LeadOrbiq"
  >
    <ellipse
      cx="16"
      cy="16"
      rx="13"
      ry="7.5"
      transform="rotate(-24 16 16)"
      stroke="var(--color-brand)"
      stroke-width="2"></ellipse>
    <circle cx="16" cy="16" r="5.5" fill="var(--color-brand)"></circle>
    <circle cx="16" cy="16" r="2.1" fill="var(--color-bg, #050816)"></circle>
    <circle cx="26.4" cy="10.2" r="2.4" fill="var(--color-brand)"></circle>
  </svg>
  {
    variant === "full" && (
      <span class="text-lg font-semibold tracking-tight text-[var(--color-text-primary)]">
        LeadOrbiq
      </span>
    )
  }
</span>
