---
import { Image } from "astro:assets";
import logo from "@/assets/brand/logo.png";

interface Props {
  variant?: "icon" | "full";
  size?: number;
  class?: string;
}

const { variant = "icon", size = 32, class: className = "" } = Astro.props;
---

<span class:list={["inline-flex items-center gap-2.5", className]}>
  <Image src={logo} width={size} height={size} alt="LeadOrbiq" class="shrink-0" />
  {
    variant === "full" && (
      <span class="text-lg font-semibold tracking-tight text-[var(--color-text-primary)]">
        LeadOrbiq
      </span>
    )
  }
</span>
