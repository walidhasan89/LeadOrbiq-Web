---
interface Props {
  variant?: "hero" | "section" | "footer";
  class?: string;
}
const { variant = "section", class: className = "" } = Astro.props;
const uid = crypto.randomUUID().slice(0, 8);
const gridId = `grid-${uid}`;
---

<div
  class:list={["pointer-events-none absolute inset-0 -z-10 overflow-hidden", className]}
  aria-hidden="true"
>
  <svg
    class="absolute inset-0 h-full w-full opacity-60 dark:opacity-40"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <pattern id={gridId} width="64" height="64" patternUnits="userSpaceOnUse">
        <path d="M 64 0 L 0 0 0 64" fill="none" stroke="var(--color-border)" stroke-width="1"
        ></path>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill={`url(#${gridId})`}></rect>
  </svg>

  {
    variant === "hero" && (
      <>
        <div class="glow-orb glow-orb-a absolute -left-24 top-0 h-[26rem] w-[26rem] rounded-full opacity-70 blur-3xl" />
        <div class="glow-orb glow-orb-b absolute -right-32 top-40 h-[30rem] w-[30rem] rounded-full opacity-60 blur-3xl" />
      </>
    )
  }
  {
    variant === "section" && (
      <div class="glow-orb glow-orb-a absolute left-1/2 top-0 h-[24rem] w-[24rem] -translate-x-1/2 rounded-full opacity-40 blur-3xl" />
    )
  }

  <div class="grain-overlay"></div>
</div>

<style>
  .glow-orb {
    background: var(--gradient-glow);
    animation: drift var(--duration-ambient) var(--ease-orbit) infinite;
  }
  .glow-orb-b {
    animation-delay: -6s;
    animation-duration: 20s;
  }
</style>
