---
interface Props {
  activeStep?: number;
  class?: string;
}
const { activeStep = 1, class: className = "" } = Astro.props;

const stages = [
  { label: "Search", icon: "M11 4.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13Zm9.5 15.5-5-5" },
  { label: "Select", icon: "M3.5 8.5 6.5 11.5 12.5 4.5" },
  { label: "Organize", icon: "M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z" },
  { label: "Review", icon: "M4 12s3-6 8-6 8 6 8 6-3 6-8 6-8-6-8-6Z M12 12a2 2 0 1 0 0-.01" },
  { label: "Outreach", icon: "M4 6.5 12 12l8-5.5M4 6.5v11h16v-11" },
];

type StageState = "done" | "active" | "upcoming";
const stateOf = (step: number): StageState =>
  step < activeStep ? "done" : step === activeStep ? "active" : "upcoming";

const box = "relative flex h-12 w-12 shrink-0 items-center justify-center border-2";
const boxState: Record<StageState, string> = {
  active:
    "border-transparent bg-[image:var(--gradient-brand)] text-white shadow-[var(--shadow-glow)]",
  done: "border-[var(--color-brand)] bg-[var(--color-brand)]/10 text-[var(--color-brand)]",
  upcoming:
    "border-[var(--color-border-strong)] bg-[var(--color-bg-elevated)] text-[var(--color-text-secondary)]",
};
const labelState: Record<StageState, string> = {
  active: "text-[var(--color-text-primary)]",
  done: "text-[var(--color-text-primary)]",
  upcoming: "text-[var(--color-text-secondary)]",
};
---

<div class:list={[className]}>
  {/* Desktop: horizontal stepper. Connectors are siblings between the step
      columns (not children of them) and offset to the icon's centerline, so
      every icon, line, and label lands on the same grid. */}
  <ol class="hidden sm:flex sm:items-start">
    {
      stages.map((stage, index) => {
        const step = index + 1;
        const state = stateOf(step);
        return (
          <>
            <li class="flex w-28 shrink-0 flex-col items-center gap-3 text-center">
              <span class:list={[box, boxState[state]]} aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  class="h-5 w-5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d={stage.icon} />
                </svg>
                <span class="absolute -right-2 -top-2 flex h-5 w-5 items-center justify-center border border-[var(--color-border-strong)] bg-[var(--color-bg-elevated)] text-[0.6rem] font-bold text-[var(--color-text-secondary)]">
                  {step}
                </span>
              </span>
              <span class:list={["text-sm font-semibold", labelState[state]]}>{stage.label}</span>
            </li>
            {index < stages.length - 1 && (
              <li
                aria-hidden="true"
                class:list={[
                  "mt-[23px] h-0.5 min-w-6 flex-1",
                  step < activeStep ? "bg-[var(--color-brand)]" : "bg-[var(--color-border)]",
                ]}
              />
            )}
          </>
        );
      })
    }
  </ol>

  {/* Mobile: vertical stepper — the horizontal one can't stay legible at
      narrow widths, so the connector runs down the icon column instead. */}
  <ol class="flex flex-col sm:hidden">
    {
      stages.map((stage, index) => {
        const step = index + 1;
        const state = stateOf(step);
        const isLast = index === stages.length - 1;
        return (
          <li class="flex gap-4">
            <div class="flex flex-col items-center">
              <span class:list={[box, boxState[state]]} aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  class="h-5 w-5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d={stage.icon} />
                </svg>
                <span class="absolute -right-2 -top-2 flex h-5 w-5 items-center justify-center border border-[var(--color-border-strong)] bg-[var(--color-bg-elevated)] text-[0.6rem] font-bold text-[var(--color-text-secondary)]">
                  {step}
                </span>
              </span>
              {!isLast && (
                <span
                  aria-hidden="true"
                  class:list={[
                    "w-0.5 flex-1",
                    step < activeStep ? "bg-[var(--color-brand)]" : "bg-[var(--color-border)]",
                  ]}
                />
              )}
            </div>
            <span
              class:list={[
                "pt-3 text-sm font-semibold",
                isLast ? "" : "pb-8",
                labelState[state],
              ]}
            >
              {stage.label}
            </span>
          </li>
        );
      })
    }
  </ol>
</div>
