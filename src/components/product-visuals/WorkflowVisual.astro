---
interface Props {
  activeStep?: number;
  class?: string;
}
const { activeStep = 1, class: className = "" } = Astro.props;

const stages = [
  { label: "Search", icon: "M11 4.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13Zm9.5 15.5-5-5" },
  { label: "Select", icon: "M3.5 8.5 6.5 11.5 12.5 4.5" },
  { label: "Organize", icon: "M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z" },
  { label: "Review", icon: "M4 12s3-6 8-6 8 6 8 6-3 6-8 6-8-6-8-6Z M12 12a2 2 0 1 0 0-.01" },
  { label: "Outreach", icon: "M4 6.5 12 12l8-5.5M4 6.5v11h16v-11" },
];
---

<div class:list={["flex flex-col gap-0 sm:flex-row sm:items-start sm:gap-2", className]}>
  {
    stages.map((stage, index) => {
      const step = index + 1;
      const state = step < activeStep ? "done" : step === activeStep ? "active" : "upcoming";
      return (
        <div class="flex flex-1 items-start gap-3 sm:flex-col sm:items-center sm:gap-3 sm:text-center">
          <div class="flex flex-col items-center sm:w-full">
            <span
              class:list={[
                "flex h-11 w-11 shrink-0 items-center justify-center rounded-full border-2 transition-colors duration-[var(--duration-control)]",
                state === "active" &&
                  "border-transparent bg-[image:var(--gradient-brand)] text-white shadow-[var(--shadow-glow)]",
                state === "done" && "border-[var(--color-brand)] text-[var(--color-brand)]",
                state === "upcoming" &&
                  "border-[var(--color-border)] text-[var(--color-text-secondary)]",
              ]}
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 24 24"
                class="h-5 w-5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d={stage.icon} />
              </svg>
            </span>
            {index < stages.length - 1 && (
              <span
                class:list={[
                  "mt-1 hidden h-0.5 w-full sm:block",
                  state === "done" ? "bg-[var(--color-brand)]" : "bg-[var(--color-border)]",
                ]}
                aria-hidden="true"
              />
            )}
          </div>
          <span
            class:list={[
              "pt-2 text-sm font-medium sm:pt-0",
              state === "upcoming"
                ? "text-[var(--color-text-secondary)]"
                : "text-[var(--color-text-primary)]",
            ]}
          >
            {stage.label}
          </span>
        </div>
      );
    })
  }
</div>
