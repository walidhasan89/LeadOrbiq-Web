---
// Illustrates exporting an organized list to CSV or Excel.
---

<div
  class="glass-panel flex flex-col gap-4 rounded-[var(--radius-card)] p-6"
  role="img"
  aria-label="Illustrative tray showing an organized lead list ready for an outreach workflow"
>
  <div class="flex items-center justify-between">
    <span class="text-sm font-semibold text-[var(--color-text-primary)]">4 leads organized</span>
    <span
      class="rounded-full bg-[var(--color-success)]/12 px-2.5 py-1 text-xs font-medium text-[var(--color-success)]"
      >Ready to review</span
    >
  </div>
  <div
    class="flex items-center gap-3 rounded-[var(--radius-md)] border border-dashed border-[var(--color-brand)]/40 bg-[var(--color-brand)]/5 px-4 py-4"
  >
    <svg
      aria-hidden="true"
      class="h-8 w-8 shrink-0 text-[var(--color-brand)]"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M12 4v11m0-11 4 4m-4-4-4 4M5 16v2a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-2"></path>
    </svg>
    <div class="flex flex-col gap-0.5">
      <span class="text-sm font-medium text-[var(--color-text-primary)]">Export to CSV or Excel</span>
      <span class="text-xs text-[var(--color-text-secondary)]"
        >Send your finished list straight to outreach or your CRM.</span
      >
    </div>
  </div>
</div>
