---
import BrowserFrame from "@components/product-visuals/BrowserFrame.astro";
import MapLeadVisual from "@components/product-visuals/MapLeadVisual.astro";
import ExtensionPanelVisual from "@components/product-visuals/ExtensionPanelVisual.astro";
---

<div class="relative">
  <div
    class="orbit-ring pointer-events-none absolute -inset-10 -z-10 hidden rounded-none border border-dashed border-[var(--color-brand)]/20 sm:block"
    aria-hidden="true"
  >
  </div>
  <BrowserFrame class="shadow-[var(--shadow-elevation)]">
    <div class="grid gap-4 p-4 lg:grid-cols-[1.4fr_1fr]">
      <MapLeadVisual />
      <ExtensionPanelVisual />
    </div>
  </BrowserFrame>

  <div
    class="floating-node absolute -right-4 -top-4 hidden h-14 w-14 items-center justify-center rounded-none border border-[var(--color-border)] bg-[var(--color-bg-elevated)] shadow-[var(--shadow-glow)] sm:flex"
    aria-hidden="true"
  >
    <svg
      viewBox="0 0 24 24"
      class="h-6 w-6 text-[var(--color-accent)]"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M12 3v3M12 18v3M3 12h3M18 12h3"></path>
      <circle cx="12" cy="12" r="5.5"></circle>
    </svg>
  </div>
</div>

<style>
  .orbit-ring {
    animation: orbit-spin 40s linear infinite;
  }
  .floating-node {
    animation: drift 9s var(--ease-orbit) infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .orbit-ring,
    .floating-node {
      animation: none;
    }
  }
</style>
