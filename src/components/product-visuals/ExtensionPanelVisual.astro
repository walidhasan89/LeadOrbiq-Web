---
import LogoMark from "@components/common/LogoMark.astro";

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;

const leads = [
  { name: "Northline Plumbing", status: "Collected" },
  { name: "ClearFlow Septic", status: "Collected" },
  { name: "Greenway Drainage", status: "Reviewing" },
];
---

<div
  class:list={[
    "glass-panel-strong flex w-full flex-col gap-5 rounded-[var(--radius-card)] p-5",
    className,
  ]}
  role="img"
  aria-label="Illustrative LeadOrbiq extension panel showing three collected local-business leads"
>
  <div class="flex items-center justify-between">
    <LogoMark size={22} />
    <span
      class="rounded-none bg-[var(--color-brand)]/12 px-2.5 py-1 text-xs font-semibold text-[var(--color-brand)]"
    >
      {leads.length} selected
    </span>
  </div>

  <ul class="flex flex-col gap-2">
    {
      leads.map((lead, index) => (
        <li
          class="lead-row flex items-center justify-between gap-3 rounded-[var(--radius-sm)] border border-[var(--color-border)] bg-[var(--color-bg-elevated)]/60 px-3.5 py-2.5"
          style={`animation-delay:${index * 140}ms`}
        >
          <span class="flex items-center gap-2.5 truncate text-sm font-medium text-[var(--color-text-primary)]">
            <svg
              aria-hidden="true"
              class="h-4 w-4 shrink-0 text-[var(--color-success)]"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M3.5 8.5 6.5 11.5 12.5 4.5" />
            </svg>
            <span class="truncate">{lead.name}</span>
          </span>
          <span class="shrink-0 text-xs text-[var(--color-text-secondary)]">{lead.status}</span>
        </li>
      ))
    }
  </ul>

  <div class="flex items-center justify-between border-t border-[var(--color-border)] pt-4">
    <span class="text-xs text-[var(--color-text-secondary)]">Organizing your list…</span>
    <span
      class="flex h-6 w-6 items-center justify-center rounded-none border border-[var(--color-border)]"
      aria-hidden="true"
    >
      <span
        class="orbit-spinner h-3 w-3 rounded-none border-2 border-[var(--color-brand)] border-t-transparent"
      ></span>
    </span>
  </div>
</div>

<style>
  .lead-row {
    animation: row-in 500ms var(--ease-orbit) backwards;
  }
  @keyframes row-in {
    from {
      opacity: 0;
      transform: translateX(10px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
  .orbit-spinner {
    animation: orbit-spin 1.1s linear infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .lead-row {
      animation: none;
    }
    .orbit-spinner {
      animation-duration: 3s;
    }
  }
</style>
