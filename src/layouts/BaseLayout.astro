---
import "@/styles/global.css";
import SEOHead from "@components/seo/SEOHead.astro";
import PageLoader from "@components/common/PageLoader.astro";
import ScrollToTop from "@components/common/ScrollToTop.astro";
import type { SEOProps } from "@/types";

interface Props extends SEOProps {}

const props = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-pt-24">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#050816" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F7F9FF" media="(prefers-color-scheme: light)" />

    <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icons/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!--
      Satoshi via Fontshare's official CDN. Fontshare's license allows this
      free for personal and commercial use; self-hosting the raw font files
      on our own server would additionally require ITF's written consent, so
      loading through their API avoids that requirement entirely.
    -->
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=satoshi@400,401,500,501,700,701,900,901&display=swap"
    />

    <SEOHead {...props} />

    <script is:inline>
      (function () {
        try {
          var STORAGE_KEY = "leadorbiq-theme";
          var stored = localStorage.getItem(STORAGE_KEY);
          var systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          var resolved =
            stored === "light" || stored === "dark" ? stored : systemDark ? "dark" : "light";
          document.documentElement.setAttribute("data-theme", resolved);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      })();
    </script>
  </head>
  <body class="relative">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <PageLoader />
    <slot />
    <ScrollToTop />

    <script>
      // Page-load preloader: shown briefly on an outgoing internal-page click
      // (native cross-document view transitions, opted into via `@view-transition`
      // in global.css, handle the smooth crossfade itself — this loader just
      // covers the perceived-latency gap on slower connections). Plain
      // multi-page navigation throughout — no SPA router — so every other
      // script on the site keeps its normal fresh-page-load initialization.
      const loader = document.getElementById("page-loader");
      const SHOW_DELAY_MS = 120;
      const STUCK_SAFETY_MS = 4000;
      let showTimer: ReturnType<typeof setTimeout> | undefined;

      document.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        const link = (event.target as HTMLElement | null)?.closest?.("a[href]") as
          | HTMLAnchorElement
          | null;
        if (!link || link.target === "_blank" || link.hasAttribute("download")) return;

        const url = new URL(link.href, window.location.href);
        if (url.origin !== window.location.origin) return;
        if (url.pathname === window.location.pathname && url.search === window.location.search) {
          return; // same-page anchor/hash navigation, no full load happening
        }

        clearTimeout(showTimer);
        showTimer = setTimeout(() => {
          loader?.classList.add("is-active");
          setTimeout(() => loader?.classList.remove("is-active"), STUCK_SAFETY_MS);
        }, SHOW_DELAY_MS);
      });

      // Scroll-reveal for top-level page sections. Sections already in the
      // initial viewport are marked visible immediately with no animation,
      // so only content actually revealed by scrolling animates in.
      const revealObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              revealObserver.unobserve(entry.target);
            }
          }
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.12 },
      );

      document.querySelectorAll<HTMLElement>("main > section").forEach((section) => {
        section.classList.add("reveal-section");
        const alreadyVisible = section.getBoundingClientRect().top < window.innerHeight * 0.9;
        if (alreadyVisible) {
          section.classList.add("is-visible");
        } else {
          revealObserver.observe(section);
        }
      });

      // Safety net: renderers that don't simulate real scrolling (some
      // crawlers, print/PDF, full-page screenshot tools) never fire
      // IntersectionObserver, so nothing would reveal. Force everything
      // visible after a short delay so content is never permanently hidden.
      setTimeout(() => {
        revealObserver.disconnect();
        document.querySelectorAll<HTMLElement>("main > section").forEach((section) => {
          section.classList.add("is-visible");
        });
      }, 2500);
    </script>
  </body>
</html>
