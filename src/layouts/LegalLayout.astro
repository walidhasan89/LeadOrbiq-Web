---
import MarketingLayout from "@layouts/MarketingLayout.astro";
import Container from "@components/common/Container.astro";
import type { SEOProps } from "@/types";

interface Props extends SEOProps {
  title: string;
  lastUpdated: string;
}

const { lastUpdated, ...seo } = Astro.props;
---

<MarketingLayout
  {...seo}
  breadcrumbs={[{ label: seo.title, href: seo.pathname }]}
  breadcrumbsSize="narrow"
>
  <Container size="narrow" class="section-spacing">
    <header class="mb-10 flex flex-col gap-3 border-b border-[var(--color-border)] pb-8">
      <h1 class="text-h1 font-semibold text-[var(--color-text-primary)]">{seo.title}</h1>
      <p class="text-sm text-[var(--color-text-secondary)]">Last updated: {lastUpdated}</p>
    </header>
    <div class="legal-prose flex flex-col gap-6 text-[var(--color-text-secondary)]">
      <slot />
    </div>
  </Container>
</MarketingLayout>

<style>
  .legal-prose :global(h2) {
    margin-top: 1.5rem;
    font-size: var(--text-h4);
    font-weight: 600;
    color: var(--color-text-primary);
  }
  .legal-prose :global(h3) {
    margin-top: 0.5rem;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }
  .legal-prose :global(p) {
    max-width: 72ch;
  }
  .legal-prose :global(ul) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .legal-prose :global(a) {
    color: var(--color-brand);
    text-underline-offset: 3px;
  }
  .legal-prose :global(a:hover) {
    text-decoration: underline;
  }
</style>
