---
import MarketingLayout from "@layouts/MarketingLayout.astro";
import Container from "@components/common/Container.astro";
import SectionHeading from "@components/common/SectionHeading.astro";
import PricingCard from "@components/common/PricingCard.astro";
import Button from "@components/common/Button.astro";
import FAQAccordion from "@components/common/FAQAccordion.astro";
import GlowBackground from "@components/product-visuals/GlowBackground.astro";
import { pricingPlans } from "@data/pricing";
import { siteConfig } from "@data/site";
import type { FAQItem } from "@data/faq";

const pricingFaq: FAQItem[] = [
  {
    question: "Is there a free plan?",
    answer:
      "LeadOrbiq doesn't have a free plan. Choose Monthly, Yearly, or Lifetime billing — every plan includes full access to the extension.",
  },
  {
    question: "How does billing work?",
    answer:
      "Monthly renews every month, Yearly renews once a year at a lower effective rate, and Lifetime is a single one-time payment with no renewals.",
  },
  {
    question: "Can I cancel anytime?",
    answer:
      "Monthly and Yearly plans can be cancelled anytime — you'll keep access through the end of your current billing period. Lifetime is a one-time purchase and doesn't renew, so there's nothing to cancel.",
  },
  {
    question: "Can teams use LeadOrbiq?",
    answer:
      "Team seats aren't part of the current plans. If you need multiple people using LeadOrbiq, reach out through the Contact page and we'll help.",
  },
];

const billingHighlights = [
  {
    title: "Switch anytime",
    body: "Start on Monthly and move to Yearly or Lifetime later — you're never locked in.",
  },
  {
    title: "One product, no feature gates",
    body: "Every plan gets the same LeadOrbiq extension. You're only choosing how you pay.",
  },
  {
    title: "Questions about billing",
    body: "Reach out through the Contact page for billing or purchase questions — we respond promptly.",
  },
];
---

<MarketingLayout
  title="Pricing — LeadOrbiq"
  description="LeadOrbiq pricing: $6.99/month, $49.99/year, or $99.99 one-time for lifetime access. One product, full access on every plan."
  pathname="/pricing/"
  breadcrumbs={[{ label: "Pricing", href: "/pricing/" }]}
>
  <section class="relative overflow-hidden pb-16 pt-16 sm:pt-20">
    <GlowBackground variant="hero" />
    <Container size="content">
      <SectionHeading
        level="h1"
        align="center"
        eyebrow="Simple options"
        title="Straightforward pricing for practical prospecting."
        body="One product. Choose how you'd rather pay for it — no hidden tiers or confusing add-ons."
      />
    </Container>
  </section>

  <section class="section-spacing pt-8">
    <Container size="main">
      <div class="reveal-stagger grid gap-6 lg:grid-cols-3">
        {pricingPlans.map((plan) => <PricingCard plan={plan} />)}
      </div>
    </Container>
  </section>

  <section class="section-spacing border-t border-[var(--color-border)]">
    <Container size="main">
      <SectionHeading eyebrow="How billing works" title="Every plan, the same LeadOrbiq." />
      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        {
          billingHighlights.map((item) => (
            <div class="flex flex-col gap-3 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-7">
              <h3 class="text-lg font-semibold text-[var(--color-text-primary)]">{item.title}</h3>
              <p class="text-sm text-[var(--color-text-secondary)]">{item.body}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <section class="section-spacing border-t border-[var(--color-border)]">
    <Container size="content">
      <SectionHeading align="center" eyebrow="Common questions" title="Pricing FAQ" />
      <div class="mt-12">
        <FAQAccordion items={pricingFaq} idPrefix="pricing-faq" />
      </div>
    </Container>
  </section>

  <section class="section-spacing border-t border-[var(--color-border)]">
    <Container size="content">
      <div class="flex flex-col items-center gap-6 text-center">
        <h2 class="balance text-h2 font-semibold text-[var(--color-text-primary)]">
          Start with LeadOrbiq in Chrome.
        </h2>
        <Button href={siteConfig.chromeStoreUrl} external size="lg">Add to Chrome</Button>
      </div>
    </Container>
  </section>
</MarketingLayout>
