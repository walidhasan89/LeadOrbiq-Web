---
import MarketingLayout from "@layouts/MarketingLayout.astro";
import Container from "@components/common/Container.astro";
import SectionHeading from "@components/common/SectionHeading.astro";
import Button from "@components/common/Button.astro";
import GlowBackground from "@components/product-visuals/GlowBackground.astro";
import { useCases } from "@data/use-cases";
import { siteConfig } from "@data/site";

const guidance = [
  "Verify key details before reaching out to a business.",
  "Personalize every message instead of sending one generic script.",
  "Follow applicable privacy and marketing laws for your target region.",
  "Respect Google Maps' and any other platform's terms of use.",
  "Identify yourself and your business accurately in outreach.",
  "Provide a clear, easy way for recipients to opt out.",
];
---

<MarketingLayout
  title="Use Cases — LeadOrbiq"
  description="See how local SEO agencies, web design agencies, freelancers, sales teams, and consultants use LeadOrbiq to organize Google Maps prospecting."
  pathname="/use-cases/"
  breadcrumbs={[{ label: "Use Cases", href: "/use-cases/" }]}
>
  <section class="relative overflow-hidden pb-16 pt-16 sm:pt-20">
    <GlowBackground variant="hero" />
    <Container size="content">
      <SectionHeading
        level="h1"
        align="center"
        eyebrow="Made for people who build targeted lists"
        title="Built for teams that research and contact local businesses."
        body="Whether you sell SEO, web design, consulting, or another B2B service, LeadOrbiq helps make prospect-list preparation clearer and less repetitive."
      />
      <div class="mt-8 flex justify-center">
        <Button href={siteConfig.chromeStoreUrl} external size="lg">Add to Chrome</Button>
      </div>
    </Container>
  </section>

  <nav
    aria-label="Jump to use case"
    class="border-y border-[var(--color-border)] bg-[var(--color-bg-soft)] py-4"
  >
    <Container size="wide">
      <ul class="flex flex-wrap gap-2">
        {
          useCases.map((useCase) => (
            <li>
              <a
                href={`#${useCase.slug}`}
                class="inline-flex items-center rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-2 text-sm font-medium text-[var(--color-text-primary)] transition-colors hover:border-[var(--color-brand)] hover:text-[var(--color-brand)]"
              >
                {useCase.audience}
              </a>
            </li>
          ))
        }
      </ul>
    </Container>
  </nav>

  <section class="section-spacing">
    <Container size="content">
      <div class="flex flex-col gap-16">
        {
          useCases.map((useCase, index) => (
            <article
              id={useCase.slug}
              class="scroll-mt-28 grid gap-8 lg:grid-cols-[0.7fr_1.3fr] lg:items-start"
            >
              <div class="flex flex-col gap-3">
                <span class="text-sm font-semibold text-[var(--color-brand)]">0{index + 1}</span>
                <h2 class="text-h3 font-semibold text-[var(--color-text-primary)]">
                  {useCase.audience}
                </h2>
                <p class="text-sm text-[var(--color-text-secondary)]">{useCase.summary}</p>
              </div>
              <ol class="grid gap-3 sm:grid-cols-2">
                {useCase.workflow.map((step, stepIndex) => (
                  <li class="flex items-start gap-3 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-5 text-sm text-[var(--color-text-secondary)]">
                    <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-brand)]/12 text-xs font-semibold text-[var(--color-brand)]">
                      {stepIndex + 1}
                    </span>
                    {step}
                  </li>
                ))}
              </ol>
            </article>
          ))
        }
      </div>
    </Container>
  </section>

  <section class="section-spacing border-t border-[var(--color-border)]">
    <Container size="content">
      <SectionHeading
        eyebrow="Outreach workflow guidance"
        title="Turning a researched list into responsible outreach."
      />
      <ul class="mt-10 grid gap-4 sm:grid-cols-2">
        {
          guidance.map((tip) => (
            <li class="flex items-start gap-3 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-5 text-sm text-[var(--color-text-secondary)]">
              <svg
                aria-hidden="true"
                class="mt-0.5 h-4 w-4 shrink-0 text-[var(--color-brand)]"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M3.5 8.5 6.5 11.5 12.5 4.5" />
              </svg>
              {tip}
            </li>
          ))
        }
      </ul>
    </Container>
  </section>

  <section class="section-spacing border-t border-[var(--color-border)]">
    <Container size="content">
      <div class="flex flex-col items-center gap-6 text-center">
        <h2 class="balance text-h2 font-semibold text-[var(--color-text-primary)]">
          Find the workflow that matches how your team prospects.
        </h2>
        <div class="flex flex-col gap-4 sm:flex-row">
          <Button href={siteConfig.chromeStoreUrl} external size="lg">Add to Chrome</Button>
          <Button href="/features/" variant="secondary" size="lg">Explore Features</Button>
        </div>
      </div>
    </Container>
  </section>
</MarketingLayout>
