---
import MarketingLayout from "@layouts/MarketingLayout.astro";
import Container from "@components/common/Container.astro";
import SectionHeading from "@components/common/SectionHeading.astro";
import FeatureCard from "@components/common/FeatureCard.astro";
import Button from "@components/common/Button.astro";
import FAQAccordion from "@components/common/FAQAccordion.astro";
import WorkflowVisual from "@components/product-visuals/WorkflowVisual.astro";
import MapLeadVisual from "@components/product-visuals/MapLeadVisual.astro";
import ExtensionPanelVisual from "@components/product-visuals/ExtensionPanelVisual.astro";
import LeadTableVisual from "@components/product-visuals/LeadTableVisual.astro";
import GlowBackground from "@components/product-visuals/GlowBackground.astro";
import { detailedFeatures } from "@data/features";
import { dataFields, leadOrbiqWorkflow } from "@data/workflow";
import { homepageFaq } from "@data/faq";
import { siteConfig } from "@data/site";
import { faqSchema } from "@utils/seo";

const featureIcons: Array<
  "map" | "grid" | "clock" | "review" | "layers" | "export" | "duplicate" | "search"
> = ["search", "map", "review", "export", "grid", "layers"];

const featuresFaq = homepageFaq.filter((item) =>
  [
    "What is LeadOrbiq?",
    "What business information can it collect?",
    "Can I export my lead list?",
    "Does LeadOrbiq work with Google Maps?",
    "Can I filter my search results?",
    "What happens when a niche runs out of businesses in an area?",
  ].includes(item.question),
);
const featuresFaqSchema = faqSchema(featuresFaq);
---

<MarketingLayout
  title="Features — LeadOrbiq"
  description="See how LeadOrbiq organizes Google Maps prospecting: verified capabilities, the collection workflow, and which data fields are confirmed today."
  pathname="/features/"
  breadcrumbs={[{ label: "Features", href: "/features/" }]}
  schemas={[featuresFaqSchema]}
>
  <section class="relative overflow-hidden pb-16 pt-16 sm:pt-20">
    <GlowBackground variant="hero" />
    <Container size="content">
      <SectionHeading
        level="h1"
        align="center"
        eyebrow="Product"
        title="A more organized way to collect local-business leads."
        body="LeadOrbiq brings structure to Google Maps prospecting so you can reduce repetitive work, review prospects more clearly, and prepare better outreach lists."
      />
      <div class="mt-8 flex justify-center">
        <Button href={siteConfig.chromeStoreUrl} external size="lg">Add to Chrome</Button>
      </div>
    </Container>
  </section>

  <section class="section-spacing border-t border-[var(--color-border)]">
    <Container size="wide">
      <SectionHeading eyebrow="Feature overview" title="What LeadOrbiq helps you do today." />
      <div class="reveal-stagger mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          detailedFeatures.map((feature, index) => (
            <FeatureCard
              title={feature.title}
              description={feature.description}
              verified={feature.verified}
              icon={featureIcons[index % featureIcons.length]}
            />
          ))
        }
      </div>
    </Container>
  </section>

  <section class="section-spacing border-t border-[var(--color-border)]">
    <Container size="wide">
      <SectionHeading
        eyebrow="Detailed product workflow"
        title="From a Google Maps search to a ready-to-use list."
      />
      <div class="mt-12">
        <WorkflowVisual activeStep={5} />
      </div>
      <ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          leadOrbiqWorkflow.map((step, index) => (
            <li class="flex items-start gap-3 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-5 text-sm text-[var(--color-text-secondary)]">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-none bg-[var(--color-brand)]/12 text-xs font-semibold text-[var(--color-brand)]">
                {index + 1}
              </span>
              {step}
            </li>
          ))
        }
      </ol>
    </Container>
  </section>

  <section class="section-spacing border-t border-[var(--color-border)]">
    <Container size="wide">
      <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:items-center">
        <SectionHeading
          eyebrow="Verified data fields"
          title="Only confirmed fields are shown as capabilities."
          body="LeadOrbiq is designed to organize business information gathered during prospect research. Fields marked Verify are planned structure, not confirmed capability — they will move to confirmed once validated against the current extension version."
        />
        <div class="flex flex-col gap-3">
          {
            dataFields.map((field) => (
              <div
                class:list={[
                  "flex items-center justify-between rounded-[var(--radius-sm)] border px-4 py-3 text-sm",
                  field.verified
                    ? "border-[var(--color-brand)]/30 bg-[var(--color-brand)]/6"
                    : "border-[var(--color-border)]",
                ]}
              >
                <span class="font-medium text-[var(--color-text-primary)]">{field.label}</span>
                <span
                  class:list={[
                    "text-xs font-semibold uppercase tracking-wide",
                    field.verified ? "text-[var(--color-success)]" : "text-[var(--color-warning)]",
                  ]}
                >
                  {field.verified ? "Confirmed" : "Verify"}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  <section class="section-spacing border-t border-[var(--color-border)]">
    <Container size="wide">
      <SectionHeading
        eyebrow="Productivity improvements"
        title="Less time on data entry, more time on outreach."
      />
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        <div
          class="flex flex-col gap-3 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-7"
        >
          <h3 class="text-lg font-semibold text-[var(--color-text-primary)]">
            Fewer repetitive steps
          </h3>
          <p class="text-sm text-[var(--color-text-secondary)]">
            Reduce the routine tab switching and manual entry involved in building a prospect list
            from Google Maps results.
          </p>
        </div>
        <div
          class="flex flex-col gap-3 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-7"
        >
          <h3 class="text-lg font-semibold text-[var(--color-text-primary)]">Clearer review</h3>
          <p class="text-sm text-[var(--color-text-secondary)]">
            Keep the businesses you're researching easier to compare, so you can focus on the
            prospects that actually match your campaign.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <section class="section-spacing border-t border-[var(--color-border)]">
    <Container size="wide">
      <SectionHeading
        eyebrow="Interface walkthrough"
        title="An illustrative look at the collection workflow."
        body="These panels are illustrative demonstrations built with fictional business data, not live screenshots."
      />
      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        <MapLeadVisual compact class="min-h-[16rem]" />
        <ExtensionPanelVisual />
        <LeadTableVisual />
      </div>
    </Container>
  </section>

  <section class="section-spacing border-t border-[var(--color-border)]">
    <Container size="content">
      <div class="glass-panel rounded-[var(--radius-panel)] p-8 sm:p-10">
        <h2 class="text-h4 font-semibold text-[var(--color-text-primary)]">
          Use collected data responsibly
        </h2>
        <p class="mt-3 text-sm text-[var(--color-text-secondary)]">
          Verify important details, follow applicable privacy and marketing laws, respect platform
          terms, identify yourself accurately, personalize your outreach, and provide appropriate
          ways for recipients to opt out.
        </p>
        <Button href="/privacy-policy/" variant="text" class="mt-4">Read Privacy Policy →</Button>
      </div>
    </Container>
  </section>

  <section id="faq" class="section-spacing border-t border-[var(--color-border)]">
    <Container size="content">
      <SectionHeading align="center" eyebrow="Common questions" title="Feature FAQ" />
      <div class="mt-12">
        <FAQAccordion items={featuresFaq} idPrefix="features-faq" />
      </div>
    </Container>
  </section>

  <section class="section-spacing border-t border-[var(--color-border)]">
    <Container size="content">
      <div class="flex flex-col items-center gap-6 text-center">
        <h2 class="balance text-h2 font-semibold text-[var(--color-text-primary)]">
          Bring structure to your next prospecting campaign.
        </h2>
        <Button href={siteConfig.chromeStoreUrl} external size="lg">Add to Chrome</Button>
      </div>
    </Container>
  </section>
</MarketingLayout>
