---
import MarketingLayout from "@layouts/MarketingLayout.astro";
import Container from "@components/common/Container.astro";
import SectionHeading from "@components/common/SectionHeading.astro";
import GlowBackground from "@components/product-visuals/GlowBackground.astro";
import { getCollection } from "astro:content";
import { helpCategories } from "@/content.config";

const allArticles = await getCollection("help");
const sorted = allArticles.sort((a, b) => a.data.order - b.data.order);

const categoriesInUse = helpCategories.filter((category) =>
  sorted.some((article) => article.data.category === category),
);
---

<MarketingLayout
  title="Help Center — LeadOrbiq"
  description="Installation, Google Maps workflow, lead collection, exporting, privacy, and troubleshooting guides for LeadOrbiq."
  pathname="/help/"
  breadcrumbs={[{ label: "Help Center", href: "/help/" }]}
>
  <section class="relative overflow-hidden pb-12 pt-16 sm:pt-20">
    <GlowBackground variant="hero" />
    <Container size="content">
      <SectionHeading
        level="h1"
        align="center"
        eyebrow="Support"
        title="How can we help with LeadOrbiq?"
      />
      <div class="mx-auto mt-8 max-w-lg">
        <label for="help-search" class="sr-only">Search help articles</label>
        <div class="relative">
          <svg
            aria-hidden="true"
            class="pointer-events-none absolute left-4 top-1/2 h-4.5 w-4.5 -translate-y-1/2 text-[var(--color-text-secondary)]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
          >
            <path d="M11 4.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13Zm9.5 15.5-5-5"></path>
          </svg>
          <input
            type="search"
            id="help-search"
            placeholder="Search installation, lead collection, exporting, privacy..."
            class="w-full rounded-[var(--radius-pill)] border border-[var(--color-border)] bg-[var(--color-surface)] py-3.5 pl-11 pr-4 text-sm text-[var(--color-text-primary)] outline-none transition-colors focus-visible:border-[var(--color-brand)]"
          />
        </div>
        <p
          id="help-search-status"
          class="mt-2 text-center text-xs text-[var(--color-text-secondary)]"
          role="status"
          aria-live="polite"
        >
        </p>
      </div>
    </Container>
  </section>

  <section class="border-y border-[var(--color-border)] bg-[var(--color-bg-soft)] py-4">
    <Container size="main">
      <div class="flex flex-wrap justify-center gap-2" role="group" aria-label="Filter by category">
        <button
          type="button"
          data-category-filter="all"
          aria-pressed="true"
          class="category-pill rounded-none border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-2 text-sm font-medium text-[var(--color-text-primary)] transition-colors"
        >
          All topics
        </button>
        {
          categoriesInUse.map((category) => (
            <button
              type="button"
              data-category-filter={category}
              aria-pressed="false"
              class="category-pill rounded-none border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-2 text-sm font-medium text-[var(--color-text-primary)] transition-colors"
            >
              {category}
            </button>
          ))
        }
      </div>
    </Container>
  </section>

  <section class="section-spacing pt-10">
    <Container size="main">
      <div id="help-grid" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          sorted.map((article) => (
            <a
              href={`/help/${article.id}/`}
              data-help-card
              data-category={article.data.category}
              data-search-text={`${article.data.title} ${article.data.description} ${article.data.category}`.toLowerCase()}
              class="flex flex-col gap-3 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6 transition-[transform,border-color] duration-[var(--duration-control)] hover:-translate-y-0.5 hover:border-[var(--color-brand)]/50"
            >
              <span class="w-fit rounded-none bg-[var(--color-brand)]/10 px-2.5 py-1 text-[0.7rem] font-semibold uppercase tracking-wide text-[var(--color-brand)]">
                {article.data.category}
              </span>
              <span class="text-base font-semibold text-[var(--color-text-primary)]">
                {article.data.title}
              </span>
              <span class="text-sm text-[var(--color-text-secondary)]">
                {article.data.description}
              </span>
              {!article.data.verified && (
                <span class="mt-auto w-fit rounded-none bg-[var(--color-warning)]/12 px-2.5 py-1 text-[0.65rem] font-semibold uppercase tracking-wide text-[var(--color-warning)]">
                  Verification pending
                </span>
              )}
            </a>
          ))
        }
      </div>
      <p id="help-empty-state" class="hidden py-16 text-center text-sm text-[var(--color-text-secondary)]">
        No help articles match your search.
      </p>
    </Container>
  </section>
</MarketingLayout>

<style>
  .category-pill[aria-pressed="true"] {
    border-color: var(--color-brand);
    background-color: color-mix(in srgb, var(--color-brand) 12%, transparent);
    color: var(--color-brand);
  }

  .category-pill:not([aria-pressed="true"]):hover {
    border-color: color-mix(in srgb, var(--color-brand) 50%, transparent);
    color: var(--color-brand);
  }
</style>

<script>
  const input = document.getElementById("help-search") as HTMLInputElement | null;
  const status = document.getElementById("help-search-status");
  const emptyState = document.getElementById("help-empty-state");
  const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-help-card]"));
  const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-category-filter]"));

  let activeCategory = "all";

  function applyFilters() {
    const query = (input?.value ?? "").trim().toLowerCase();
    let visibleCount = 0;

    cards.forEach((card) => {
      const matchesCategory = activeCategory === "all" || card.dataset.category === activeCategory;
      const matchesQuery = query === "" || (card.dataset.searchText ?? "").includes(query);
      const matches = matchesCategory && matchesQuery;
      card.classList.toggle("hidden", !matches);
      if (matches) visibleCount += 1;
    });

    if (emptyState) emptyState.classList.toggle("hidden", visibleCount !== 0);
    if (status) {
      status.textContent = query === "" ? "" : `${visibleCount} article${visibleCount === 1 ? "" : "s"} found`;
    }
  }

  input?.addEventListener("input", applyFilters);

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      activeCategory = button.dataset.categoryFilter ?? "all";
      filterButtons.forEach((btn) => btn.setAttribute("aria-pressed", String(btn === button)));
      applyFilters();
    });
  });
</script>
