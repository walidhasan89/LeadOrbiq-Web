# Public site URL used for canonical links, sitemap, and structured data.
PUBLIC_SITE_URL=https://leadorbiq.com

# Chrome Web Store listing URL for the "Add to Chrome" CTA. [VERIFY]
PUBLIC_CHROME_STORE_URL=

# Endpoint the contact form POSTs to. Leave empty to keep the form in
# documented placeholder mode (see docs/IMPLEMENTATION-STATUS.md).
PUBLIC_CONTACT_ENDPOINT=

# Optional analytics identifier. Leave empty to disable analytics.
PUBLIC_ANALYTICS_ID=
